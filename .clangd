CompileFlags:
  Remove:
    - -mlongcalls
    - -mdisable-hardware-atomics
    - -fstrict-volatile-bitfields
    - -fno-tree-switch-conversion

QueryDriver:
  - C:\Users\Ron\.platformio\packages\toolchain-xtensa-esp-elf\bin\xtensa-esp-elf-g++*
  - C:\Users\Ron\.platformio\packages\toolchain-xtensa-esp-elf\bin\xtensa-esp-elf-gcc*
  - C:\Users\Ron\.platformio\packages\toolchain-xtensa-esp32\bin\xtensa-esp32-elf-g++*
  - C:\Users\Ron\.platformio\packages\toolchain-xtensa-esp32\bin\xtensa-esp32-elf-gcc*

